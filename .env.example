# F_Agent 环境变量配置
# 复制此文件为 .env 并填入真实的 key（.env 已加入 .gitignore，不会提交）

# DeepSeek API Key（用于 AI 情报 / RAG 检索 / 交易记忆反思）
DEEPSEEK_API_KEY=***

# DeepSeek 模型名称（可选，默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# TypeSafe Jev 宏观文本语义因子（默认关闭外部调用；缓存仍可离线重放）
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# off=完全不使用；cache=只重放冻结缓存；online=允许API调用并写缓存
# F_AGENT_JEV_MODE=off
# 固定版本，禁止 jev-latest / jev-preview，保证历史特征可复现
# F_AGENT_JEV_MODEL=jev-1.13.0
# 在线融合仅支持 off/shadow；shadow 不改变方向与仓位
# F_AGENT_JEV_GATE_MODE=off
